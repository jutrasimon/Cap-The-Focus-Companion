{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cap",
  "version": "1.4.1",
  "identifier": "app.cap.focus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../extension/": "extension/"
    },
    "publisher": "Simon Jutras",
    "shortDescription": "Cap · focus, dossiers, sites et rappels",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NDA5NjQyOTM3QzIwNDcKUldSSElIeVRRcFpBNmQwd2ZqTzB6R2FRcm5EWVk3SVFPMkU4SU1wV1JHZVIyc1BoNGdSeGlBb3MK",
      "endpoints": [
        "https://github.com/jutrasimon/Cap-The-Focus-Companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
